{
    "name": "sierratecnologia/crypto",
    "description": "Cryptography tools for Laravel and Lumen",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "crypto"
    ],
    "license": "MIT",
    "homepage": "https://sierratecnologia.com/packages/crypto/",
    "support": {
        "email": "help@sierratecnologia.com.br",
        "issues": "https://github.com/sierratecnologia/crypto/issues",
        "source": "https://github.com/sierratecnologia/crypto",
        "docs": "https://github.com/sierratecnologia/crypto/blob/master/README.md"
    },
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-gmp": "*",
        "ext-openssl": "*",
        "defuse/php-encryption": "^2.3",
        "illuminate/support": "^13.0",
        "ramsey/uuid": "^4.9",
        "paragonie/ecc": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "mockery/mockery": "^1.6",
        "mikey179/vfsstream": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpro/grumphp": "^2.12",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "phpmd/phpmd": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "SierraTecnologia\\Crypto\\": "src/"
        },
        "files": [
            "src/Helpers/crypto.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SierraTecnologia\\Crypto\\Test\\": "test/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SierraTecnologia\\Crypto\\CryptoProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage --coverage-clover coverage.xml",
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcs:fix": "phpcbf --standard=phpcs.xml",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "psalm": "psalm --show-info=true",
        "phpmd": "phpmd src/ text phpmd.xml",
        "check": [
            "@phpcs",
            "@phpstan",
            "@psalm",
            "@phpmd",
            "@test"
        ],
        "check:ci": [
            "@phpcs",
            "@phpstan",
            "@psalm",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run unit tests",
        "test:coverage": "Run tests with coverage report",
        "phpcs": "Check code style (PSR-12)",
        "phpcs:fix": "Fix code style issues automatically",
        "phpstan": "Run static analysis with PHPStan",
        "psalm": "Run static analysis with Psalm",
        "phpmd": "Run mess detector",
        "check": "Run all quality checks",
        "check:ci": "Run CI quality checks"
    },
    "version": "2.3.0"
}
