<?xml version="1.0"?>
<ruleset name="SierraTecnologia Crypto PHPMD Rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        PHPMD rules for SierraTecnologia Crypto package
    </description>

    <!-- Clean Code Rules -->
    <rule ref="rulesets/cleancode.xml">
        <!-- Allow else expressions for better readability in some cases -->
        <exclude name="ElseExpression"/>
        <!-- Allow static access (Laravel facades) -->
        <exclude name="StaticAccess"/>
        <!-- Allow boolean flags in some cases -->
        <exclude name="BooleanArgumentFlag"/>
    </rule>

    <!-- Code Size Rules -->
    <rule ref="rulesets/codesize.xml">
        <!-- Exclude too many methods for models -->
        <exclude name="TooManyMethods"/>
        <exclude name="TooManyPublicMethods"/>
        <!-- Exclude excessive parameter list for constructors -->
        <exclude name="ExcessiveParameterList"/>
    </rule>

    <!-- Configure Cyclomatic Complexity -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="15"/>
            <property name="showClassesComplexity" value="true"/>
            <property name="showMethodsComplexity" value="true"/>
        </properties>
    </rule>

    <!-- Configure NPath Complexity -->
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <property name="minimum" value="250"/>
        </properties>
    </rule>

    <!-- Configure Excessive Method Length -->
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="150"/>
            <property name="ignore-whitespace" value="true"/>
        </properties>
    </rule>

    <!-- Configure Excessive Class Length -->
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="1000"/>
            <property name="ignore-whitespace" value="true"/>
        </properties>
    </rule>

    <!-- Configure Excessive Parameter List -->
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="6"/>
        </properties>
    </rule>

    <!-- Configure Too Many Fields -->
    <rule ref="rulesets/codesize.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="20"/>
        </properties>
    </rule>

    <!-- Configure Too Many Methods -->
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="25"/>
            <property name="ignorepattern" value="(^(set|get|is))"/>
        </properties>
    </rule>

    <!-- Configure Too Many Public Methods -->
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="15"/>
            <property name="ignorepattern" value="(^(set|get|is))"/>
        </properties>
    </rule>

    <!-- Controversial Rules -->
    <rule ref="rulesets/controversial.xml">
        <!-- Allow camel case variable names -->
        <exclude name="CamelCaseVariableName"/>
        <!-- Allow superglobals (Laravel uses them) -->
        <exclude name="Superglobals"/>
    </rule>

    <!-- Design Rules -->
    <rule ref="rulesets/design.xml">
        <!-- Allow goto (rarely used, but can be useful) -->
        <exclude name="GotoStatement"/>
        <!-- Allow eval (rarely used, but can be useful for dynamic code) -->
        <exclude name="EvalExpression"/>
    </rule>

    <!-- Configure Exit Expression -->
    <rule ref="rulesets/design.xml/ExitExpression">
        <properties>
            <property name="ignore-die" value="true"/>
        </properties>
    </rule>

    <!-- Naming Rules -->
    <rule ref="rulesets/naming.xml">
        <!-- Allow short variable names for common cases -->
        <exclude name="ShortVariable"/>
        <!-- Allow long variable names for descriptive cases -->
        <exclude name="LongVariable"/>
        <!-- Allow short method names -->
        <exclude name="ShortMethodName"/>
    </rule>

    <!-- Configure Short Variable -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="2"/>
            <property name="exceptions" value="id,i,j,k,e,ex"/>
        </properties>
    </rule>

    <!-- Configure Long Variable -->
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="30"/>
        </properties>
    </rule>

    <!-- Configure Short Method Name -->
    <rule ref="rulesets/naming.xml/ShortMethodName">
        <properties>
            <property name="minimum" value="2"/>
            <property name="exceptions" value="up,do,go"/>
        </properties>
    </rule>

    <!-- Unused Code Rules -->
    <rule ref="rulesets/unusedcode.xml">
        <!-- All unused code rules are enabled -->
    </rule>

    <!-- Exclude patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/database/migrations/*</exclude-pattern>
    <exclude-pattern>*/tests/Mocks/*</exclude-pattern>
    <exclude-pattern>*/.phpunit.cache/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

</ruleset>
