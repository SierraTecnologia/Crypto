<?xml version="1.0"?>
<ruleset name="SierraTecnologia Crypto Coding Standard">
    <description>PSR-12 coding standard for Crypto package</description>

    <!-- Show progress and sniff codes -->
    <arg value="ps"/>

    <!-- Use colors in output -->
    <arg name="colors"/>

    <!-- Show only relevant output -->
    <arg value="n"/>

    <!-- Directories to scan -->
    <file>src/</file>
    <file>tests/</file>

    <!-- Exclude patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/database/migrations/*</exclude-pattern>
    <exclude-pattern>*/.phpunit.cache/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <!-- PSR-12 Coding Standard -->
    <rule ref="PSR12">
        <!-- Allow long lines in some cases -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!-- Additional rules -->

    <!-- Enforce array syntax -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Check for TODO/FIXME comments -->
    <rule ref="Generic.Commenting.Todo"/>
    <rule ref="Generic.Commenting.Fixme"/>

    <!-- Disallow multiple statements on same line -->
    <rule ref="Generic.Formatting.DisallowMultipleStatements"/>

    <!-- Ensure no space after cast -->
    <rule ref="Generic.Formatting.SpaceAfterCast">
        <properties>
            <property name="spacing" value="0"/>
        </properties>
    </rule>

    <!-- Check for deprecated functions -->
    <rule ref="Generic.PHP.DeprecatedFunctions"/>

    <!-- Disallow backtick operator -->
    <rule ref="Generic.PHP.BacktickOperator"/>

    <!-- Forbid any content before opening tag -->
    <rule ref="Generic.PHP.CharacterBeforePHPOpeningTag"/>

    <!-- Enforce lowercase PHP constants -->
    <rule ref="Generic.PHP.LowerCaseConstant"/>
    <rule ref="Generic.PHP.LowerCaseKeyword"/>
    <rule ref="Generic.PHP.LowerCaseType"/>

    <!-- Discourage goto -->
    <rule ref="Generic.PHP.DiscourageGoto"/>

    <!-- Check for PHP syntax errors -->
    <rule ref="Generic.PHP.Syntax"/>

    <!-- Security: Disallow eval -->
    <rule ref="Squiz.PHP.Eval"/>

    <!-- Complexity checks -->
    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="10"/>
            <property name="absoluteComplexity" value="15"/>
        </properties>
    </rule>

    <rule ref="Generic.Metrics.NestingLevel">
        <properties>
            <property name="nestingLevel" value="5"/>
            <property name="absoluteNestingLevel" value="10"/>
        </properties>
    </rule>

    <!-- File size limits -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>

    <!-- Namespace and use statements -->
    <rule ref="PSR2.Namespaces.NamespaceDeclaration"/>
    <rule ref="PSR2.Namespaces.UseDeclaration"/>

    <!-- Class and method naming -->
    <rule ref="Squiz.Classes.ValidClassName"/>

    <!-- Documentation -->
    <rule ref="Squiz.Commenting.FunctionComment">
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
    </rule>

    <!-- Operator spacing -->
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>

    <!-- Enforce semicolon after statements -->
    <rule ref="Squiz.WhiteSpace.SemicolonSpacing"/>

    <!-- Check scope keywords -->
    <rule ref="Squiz.Scope.MethodScope"/>
    <rule ref="Squiz.Scope.MemberVarScope"/>

</ruleset>
